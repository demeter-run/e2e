{
  "name": "e2e",
  "private": true,
  "type": "module",
  "description": "Developer journey end-to-end tests and cross-repository contract checks for Demeter",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check": "tsx src/cli/check.ts",
    "j0": "tsx src/cli/j0.ts",
    "contract": "tsx src/cli/contract.ts",
    "mock": "tsx src/mock/main.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
